# Vercel 构建变量：开启同站点的 /api 云端数据入口。
VITE_CLOUD_SYNC_ENABLED=true
# 以下变量只在 Vercel 服务端函数中设置，绝对不要加 VITE_ 前缀。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-in-vercel-settings
DASHBOARD_READ_TOKEN=replace-with-a-random-24-character-token
DASHBOARD_ADMIN_TOKEN=replace-with-a-different-random-24-character-token
