# 依赖
node_modules/

# 构建产物
dist/
dist-ssr/

# 环境变量与密钥（.env.local 里有 GEMINI_API_KEY，绝对不要提交）
.env
.env.*
!.env.example
*.local

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 本仓库脚本产生的临时目录（浏览器调试用 profile、中间产物等）
.chrome-debug*/
.tmp-*/

# 领星 MCP 探针的原始返回（含真实店铺/销量数据，绝不能提交）
.lingxing-probe/

# 推送脚本用的凭据文件（绝不能提交）
.github-token
*.token
